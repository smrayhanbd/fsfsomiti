// This is the database schema. It defines how our data is structured.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used for migrations and interactive transactions ($transaction callbacks).
  // Routed automatically by Prisma; keeps the 43 interactive-tx call sites
  // working while the pooled `url` runs in transaction mode for serverless.
  directUrl = env("DIRECT_URL")
}

// Organization Model (For Multi-Tenant SaaS)
model Organization {
  id              String  @id @default("singleton") // singleton — one row holds our org info
  // ── Identity ──────────────────────────────────────────────────────────────
  name            String
  logo            String? // Cloudinary URL (uploaded via settings page)
  tagline         String?
  description     String? @db.Text
  // ── Contact + Address ─────────────────────────────────────────────────────
  email           String?
  phone           String?
  website         String?
  addressLine     String?
  city            String?
  district        String?
  postalCode      String?
  // ── Legal / Registration ──────────────────────────────────────────────────
  regNo           String? // society/cooperative registration no.
  licenseNo       String?
  tradeLicenseNo  String?
  establishedYear String?
  // ── Social (rendered as small links on the receipt footer) ────────────────
  facebook        String?
  whatsapp        String?
  youtube         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

// Enums
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  UNMARRIED
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum WishType {
  BIRTHDAY
  MARRIAGE
  JOINING
  FESTIVAL
}

enum WishChannel {
  SMS
  EMAIL
  BOTH
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  DECEASED
  CLOSED
  REJECTED
}

// ====================== TRUST SCORE SYSTEM (FRS v2.0) ======================

// Achievement badge award lifecycle for the per-member badge row
enum AchievementBadgeStatus {
  ACTIVE
  LOST
}

// Fine lifecycle (maps to the FINE KPI)
enum FineStatus {
  ISSUED
  PAID
  WAIVED
}

// Meeting attendance value (maps to the ATTEND KPI). EXCUSED counts as attended
// when the admin enables "approved absences count as attended" (default on).
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

// Member Model (Society Members)
model Member {
  id String @id @default(uuid())

  // Link to Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Membership Information
  memberNo       String       @unique
  membershipDate DateTime     @default(now())
  joiningDate    DateTime?
  memberType     String?
  status         MemberStatus @default(PENDING)

  // Personal Information
  firstName String
  lastName  String
  fullName  String

  gender        Gender?
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus?
  marriageDate  DateTime?

  fatherName String?
  motherName String?
  spouseName String?

  religion    String?
  nationality String?     @default("Bangladeshi")
  bloodGroup  BloodGroup?

  occupation    String?
  profession    String?
  monthlyIncome Decimal? @db.Decimal(12, 2)

  // Contact
  phone                String
  emergencyPhone       String?
  emergencyContactName String?
  // Email is NOT unique — one person may hold multiple memberships.
  email                String?

  // Identity
  nidNumber          String? @unique
  passportNumber     String? @unique
  birthCertificateNo String? @unique

  // Bank Information
  accountName   String?
  accountNumber String?
  bankName      String?
  branch        String?
  routingNumber String?

  // Photo
  photoUrl String?

  // Signature - uploaded at registration, embedded on the Membership
  // Application Form PDF. Required for member registration (validated in
  // MemberForm.tsx and MemberProfileEditForm.tsx).
  signatureUrl String?

  kycVerified Boolean @default(false)

  // Membership
  remarks String? @db.Text

  // ── Trust Score (FRS v2.0) ──────────────────────────────────────────────
  // All fields are auto-managed by the scoring engine; never edited manually.
  trustScore         Int       @default(60) // 0–100
  badgeLevel         String    @default("Silver Member")
  riskLevel          String    @default("Average")
  scoreLastUpdated   DateTime?
  // Referral: the member who referred this one. Self-referencing relation.
  referredByMemberId String?
  referredBy         Member?   @relation("MemberReferral", fields: [referredByMemberId], references: [id], onDelete: SetNull)
  referrals          Member[]  @relation("MemberReferral")

  // Relationships
  addresses     MemberAddress[]
  nominees      MemberNominee[]
  documents     MemberDocument[]
  accounts      MemberAccount[]
  savings       Savings[]
  ledgerEntries LedgerEntry[]

  // Loan relationships
  loans          Loan[]
  loanRepayments LoanRepayment[]
  loanGuarantors LoanGuarantor[] @relation("LoanGuarantorMember")

  // Special wishes
  wishLogs SpecialWishLog[]

  // Accounting
  journalEntries JournalEntry[]

  // Transactions Module
  transactions Transaction[]

  // Payment gateway integrations (bKash / Nagad) — back-relation.
  paymentIntents PaymentIntent[]

  // Trust Score relationships (FRS v2.0)
  scoreHistory       TrustScoreHistory[]
  achievementBadges  AchievementBadge[]
  fines              Fine[]
  meetingAttendances MeetingAttendance[]

  // Task Management Module — relations
  taskAssignees        TaskAssignee[]       @relation("TaskAssigneeMember")
  relatedTasks         Task[]               @relation("TaskRelatedMember")
  taskComments         TaskComment[]        @relation("TaskCommentAuthorMember")
  taskTimeLogs         TaskTimeLog[]        @relation("TaskTimeLogMember")
  taskAuditLogs        TaskAuditLog[]       @relation("TaskAuditActorMember")
  committeeMemberships CommitteeMember[]    @relation("CommitteeMemberMember")
  memberNotifications  MemberNotification[]

  // Investment & Project module — optional team links
  projectsManaged   Project[] @relation("ProjectManager")
  projectsSponsored Project[] @relation("ProjectSponsor")

  // Income Distribution Module — shares credited to this member
  distributionShares DistributionShare[]

  // Election Management Module — relations
  electionEligibility            ElectionEligibility[]           @relation("ElectionEligibilityMember")
  electionEligibilityOverrides   ElectionEligibilityOverride[]   @relation("ElectionEligibilityOverrideMember")
  electionNominations            ElectionNomination[]            @relation("ElectionNominationMember")
  electionCandidates             ElectionCandidate[]             @relation("ElectionCandidateMember")
  electionParticipation          ElectionParticipation[]         @relation("ElectionParticipationMember")
  electionNotificationRecipients ElectionNotificationRecipient[] @relation("ElectionNotificationRecipientMember")
  electionCommitteeMemberships   ElectionCommitteeMember[]       @relation("ElectionCommitteeMemberMember")
  committeeVacanciesVacated      ElectionCommitteeVacancy[]      @relation("CommitteeVacancyVacatedBy")
  committeeVacanciesFilled       ElectionCommitteeVacancy[]      @relation("CommitteeVacancyFilledBy")
  notificationDismissals         MemberNotificationDismissal[]   @relation("MemberNotificationDismissalMember")

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // deletedAt: when the member was soft-deleted. The deleteMember server action
  // sets deletedAt = now() and status = "CLOSED" instead of hard-deleting the
  // row (D6) so historical ledger entries / loan audit trails remain
  // referentially intact. Queries that should hide deleted members add
  // `WHERE deletedAt IS NULL`. NEVER use prisma.member.delete() in the app —
  // always go through deleteMember so the soft-delete + status flip happens
  // atomically inside a $transaction.
  deletedAt DateTime?

  // ── Election ballot back-relation (B24) ────────────────────────────────────
  // A member may have at most one ballot per election (uniqueness enforced on
  // ElectionBallot via @@unique([electionId, memberId])).
  electionBallots ElectionBallot[] @relation("ElectionBallotMember")

  // ── Term-deposit back-relation (Roadmap item 22) ──────────────────────────
  memberDeposits MemberDeposit[]

  createdBy       String?
  updatedBy       String?
  requests        MemberRequest[]
  profileRequests ProfileUpdateRequest[]

  // Full-text search — maintained by the member_search_vector_trigger (see
  // prisma/migrations/20260811000011_member_fts). Prisma can't represent the
  // tsvector type natively, so it's typed as Unsupported: queries that read /
  // filter by this column must go through $queryRaw with `WHERE "searchVector"
  // @@ plainto_tsquery('english', $1)`.
  searchVector Unsupported("tsvector")?

  @@index([memberNo])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([joiningDate])
  @@index([trustScore])
}

model MemberAddress {
  id            String   @id @default(uuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  addressType   String // CURRENT, PERMANENT
  village       String?
  postOffice    String?
  policeStation String?
  district      String?
  division      String?
  postalCode    String?
  country       String?  @default("Bangladesh")
  createdAt     DateTime @default(now())

  @@index([memberId])
}

model MemberNominee {
  id              String    @id @default(uuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name            String
  relation        String
  phone           String?
  email           String?
  dateOfBirth     DateTime?
  nidNumber       String?
  idType          String? // <-- ADD THIS LINE
  idDocumentUrl   String? // <-- ADD THIS LINE
  sharePercentage Decimal   @db.Decimal(5, 2)
  photoUrl        String?
  // Nominee signature - required if the nominee is an adult (18+).
  signatureUrl    String?
  documentUrl     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([memberId])
}

model MemberDocument {
  id           String    @id @default(uuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  documentType String
  name         String?
  fileName     String?
  fileUrl      String
  issueDate    DateTime?
  expiryDate   DateTime?
  uploadedAt   DateTime  @default(now())

  @@index([memberId])
}

model MemberAccount {
  id            String    @id @default(uuid())
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  username      String    @unique
  email         String?   @unique
  passwordHash  String
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([memberId])
}

// Placeholder models so Prisma validation passes
model Savings {
  id        String   @id @default(uuid())
  receiptNo String?  @unique
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  type      String // MONTHLY, DAILY, DONATION, FINE
  method    String // CASH, BKASH, BANK
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  // ── Audit trail (D5) — promote from placeholder ──────────────────────────────
  // updatedBy: admin userId who last modified the row (NULL for system-generated).
  updatedBy           String?
  // updatedAt: auto-stamped on every write; lets clients detect stale reads.
  updatedAt           DateTime @updatedAt
  // transactionMirrorId: explicit unique FK pointing to the originating
  // Transaction. Stays NULL on Savings rows created by non-transaction flows
  // (e.g. income-distribution profit credits). Backward-compatible with the
  // existing Transaction.savingsMirrorId relation — this column is an
  // additional denormalized lookup so audit queries can resolve a Savings →
  // Transaction join without going through the implicit back-relation.
  transactionMirrorId String?  @unique
  // journalLineId: optional link to the GL line that posted this Savings row,
  // for the trial-balance → member-ledger reconciliation drill-down.
  journalLineId       String?

  // Transactions Module — the member-facing mirror of an approved Transaction.
  transactionMirror Transaction?

  // Income Distribution Module — the PROFIT credit row created for this share.
  distributionShare DistributionShare?

  @@index([memberId])
}

model LedgerEntry {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  debit     Decimal? @default(0) @db.Decimal(12, 2)
  credit    Decimal? @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}

// User Model (Admins & Staff)
// role values: SUPER_ADMIN | ADMIN | MEMBER.
//   - SUPER_ADMIN: full override; can edit locked attendance/minutes any time.
//   - ADMIN: dashboard staff. Needs an explicit UserPermission row to submit
//            attendance / upload minutes; submission locks the record.
model User {
  id          String           @id @default(uuid())
  email       String           @unique
  password    String
  role        String           @default("ADMIN") // SUPER_ADMIN, ADMIN, MEMBER
  name        String?
  phone       String?
  isActive    Boolean          @default(true)
  lastLogin   DateTime?
  createdBy   String?
  permissions UserPermission[]

  // ── MFA / 2FA (Roadmap item 13) ────────────────────────────────────────────
  // twoFactorSecret: TOTP shared secret (base32) stored AES-256-GCM encrypted
  //   via lib/crypto.ts when the user enables 2FA. NULL when 2FA is off.
  // twoFactorEnabled: convenience flag for fast lookups ("show MFA enroll CTA
  //   for users where twoFactorEnabled = false"). True only after the user
  //   verifies a 6-digit TOTP code with the stored secret.
  // twoFactorBackupCodes: array of bcrypt-hashed one-time codes the user can
  //   fall back on if they lose their TOTP device. Each consumed code is
  //   removed from the array by the verify action.
  // lastMfaAt: timestamp of the most recent successful MFA challenge — used by
  //   the audit dashboard to surface stale enrollments.
  // passwordChangedAt: stamp updated whenever the password field is rewritten;
  //   sessions issued before this timestamp are invalidated by next-auth's
  //   session callback. Marked @updatedAt so the value tracks every password
  //   change (the app sets it explicitly when only the password is touched).
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorBackupCodes String[]
  lastMfaAt            DateTime?
  passwordChangedAt    DateTime? @updatedAt

  // ── MemberRequest audit back-relations (D15) ────────────────────────────────
  // All SetNull so deleting an admin doesn't wipe the request audit trail.
  reviewedMemberRequests MemberRequest[] @relation("MemberRequestReviewedBy")
  createdMemberRequests  MemberRequest[] @relation("MemberRequestCreatedBy")

  // ── Financial-year close back-relation (Roadmap item 24) ───────────────────
  closedFinancialYears FinancialYear[] @relation("FinancialYearClosedBy")

  // RBAC Module — new granular role/permission system
  roles           UserRole[]
  permOverrides   UserPermissionOverride[]
  rbacAuditActor  AuditLog[]               @relation("AuditActor")
  rbacAuditTarget AuditLog[]               @relation("AuditTargetUser")

  // Task Management Module — relations
  taskAssignees         TaskAssignee[]        @relation("TaskAssigneeUser")
  taskChecklistItems    TaskChecklistItem[]   @relation("TaskChecklistCompleter")
  taskComments          TaskComment[]         @relation("TaskCommentAuthorUser")
  taskAttachments       TaskAttachment[]      @relation("TaskAttachmentUploader")
  taskTimeLogs          TaskTimeLog[]         @relation("TaskTimeLogUser")
  taskAuditLogs         TaskAuditLog[]        @relation("TaskAuditActorUser")
  tasksCreated          Task[]                @relation("TaskCreator")
  tasksUpdated          Task[]                @relation("TaskUpdater")
  tasksApproved         Task[]                @relation("TaskApprover")
  taskApprovalRequests  TaskApprovalRequest[] @relation("TaskApprovalRequester")
  taskApprovalDecisions TaskApprovalRequest[] @relation("TaskApprovalDecider")
  committeeChairs       Committee[]           @relation("CommitteeChair")
  committeeMemberships  CommitteeMember[]     @relation("CommitteeMemberUser")

  // Election Management Module — relations (audit/observer/approval back-links)
  electionsCreated             Election[]                    @relation("ElectionCreatedBy")
  nominationsReviewed          ElectionNomination[]          @relation("NominationReviewedBy")
  candidatesApproved           ElectionCandidate[]           @relation("CandidateApprovedBy")
  candidatesDisqualified       ElectionCandidate[]           @relation("CandidateDisqualifiedBy")
  electionObserversAssigned    ElectionObserverAssignment[]  @relation("ElectionObserverAssignedBy")
  electionObserverAssignments  ElectionObserverAssignment[]  @relation("ElectionObserverUser")
  ballotKeyActivations         BallotKeyRotation[]           @relation("BallotKeyActivatedBy")
  recountRequests              RecountRequest[]              @relation("RecountRequestedBy")
  electionSettingsCaptured     ElectionSettingsSnapshot[]    @relation("ElectionSettingsCapturedBy")
  electionEligibilityOverrides ElectionEligibilityOverride[] @relation("ElectionEligibilityOverrideBy")

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([role])
}

// Enums for Accounting
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountNature {
  DEBIT
  CREDIT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

// Voucher / journal-entry type for double-entry bookkeeping
enum VoucherType {
  JOURNAL // General journal entry
  RECEIPT // Money received (cash/bank debit)
  PAYMENT // Money paid out (cash/bank credit)
  CONTRA // Between two asset accounts (e.g. bank <-> cash)
}

// Lifecycle of a journal entry
enum JournalStatus {
  DRAFT // Editable, not yet affecting balances
  POSTED // Posted to the ledger; balances updated
}

// ====================== INCOME DISTRIBUTION MODULE ======================
// Distributes income (investment income, project profit, bank interest, etc.)
// to members pro-rata by their fund share at a snapshot date. Each posting
// writes a balanced GL voucher AND per-member Savings mirror rows so member
// balances rise immediately while the aggregate liability stays in sync.

// Where the distributed income came from.
enum DistributionSourceType {
  INVESTMENT // launched from an Investment — distributes its recorded income
  PROJECT // launched from a Project — distributes net profit (revenue − expense)
  GENERAL // bank interest / other income not tied to a specific entity
}

// How each member's share is computed.
enum DistributionBasis {
  PRO_RATA // proportional to fund at snapshotDate (cooperative standard)
  EQUAL // equal split among eligible members
  MANUAL // admin-entered weights per member
}

// Lifecycle of a distribution run.
enum DistributionStatus {
  DRAFT // shares computed, voucher not yet posted
  POSTED // voucher posted; member Savings credited; balances updated
  REVERSED // reversed by a reversing voucher; mirror rows removed
}

model Account {
  id              String    @id @default(uuid())
  accountCode     String    @unique
  accountName     String
  parentAccountId String?
  parentAccount   Account?  @relation("AccountTree", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts   Account[] @relation("AccountTree")

  accountType    AccountType
  category       String?
  nature         AccountNature
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  currentBalance Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("BDT")
  description    String?       @db.Text

  isBank       Boolean       @default(false)
  isCash       Boolean       @default(false)
  allowPosting Boolean       @default(true)
  allowJournal Boolean       @default(true)
  status       AccountStatus @default(ACTIVE)

  // Extension fields for enterprise use
  taxDeductible     Boolean  @default(false)
  reconciledBalance Decimal? @db.Decimal(12, 2)

  // Double-entry postings
  journalLines JournalLine[]

  // Transactions Module — the cash/bank/wallet side of transactions
  cashTransactions Transaction[]

  // Somiti Settings → Active Bank Accounts (default COA per payment method)
  bankAccounts BankAccount[]

  // ── Investment & Project module relations ───────────────────────────
  investmentDebitAccounts     Investment[]          @relation("InvestmentDebitAccount")
  investmentCreditAccounts    Investment[]          @relation("InvestmentCreditAccount")
  investmentIncomeJournals    InvestmentIncome[]
  investmentExitJournals      InvestmentExit[]
  investmentValuationJournals InvestmentValuation[]
  projectRevenueAccounts      Project[]             @relation("ProjectRevenueAccount")
  projectExpenseAccounts      Project[]             @relation("ProjectExpenseAccount")
  projectWipAccounts          Project[]             @relation("ProjectWipAccount")

  // ── Balance-change history (D8) ───────────────────────────────────────
  // Append-only audit trail of every balance mutation, written alongside the
  // journal-entry posting. Used to reconstruct an account ledger without
  // replaying every JournalLine.
  balanceHistories AccountBalanceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite index for the chart-of-accounts tree filter: "accounts of type X by status" (D16).
  @@index([accountType, status])
}

// Journal Entry = the voucher header (one document, many lines)
model JournalEntry {
  id          String        @id @default(uuid())
  voucherNo   String        @unique // e.g. JV-0001, RV-0001, PV-0001, CV-0001
  voucherType VoucherType   @default(JOURNAL)
  entryDate   DateTime      @default(now())
  narration   String
  referenceNo String?
  memberId    String? // optional link to a member (e.g. member payment)
  member      Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status      JournalStatus @default(DRAFT)
  totalDebit  Decimal       @default(0) @db.Decimal(14, 2)
  totalCredit Decimal       @default(0) @db.Decimal(14, 2)

  // ── Financial-year tagging (Roadmap item 24) ───────────────────────────
  // Optional: which financial year this voucher was posted in. NULL on rows
  // that pre-date financial-year tracking. SetNull on year deletion so the
  // voucher is not lost.
  financialYearId String?
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id], onDelete: SetNull)

  lines JournalLine[]

  // Transactions Module — the posting created when a transaction is approved
  transactions Transaction[]

  // Investment & Project Module — vouchers auto-generated by financial events
  investmentPurchases  Investment[]
  investmentIncomes    InvestmentIncome[]
  investmentExits      InvestmentExit[]
  investmentValuations InvestmentValuation[]
  projectExpenses      ProjectExpense[]
  projectRevenues      ProjectRevenue[]

  // Income Distribution Module — posted distribution & its reversal voucher
  postedDistributions   IncomeDistribution[] @relation("DistributionPostedJournal")
  reversedDistributions IncomeDistribution[] @relation("DistributionReversalJournal")

  // ── Loan write-off voucher (B21) ────────────────────────────────────────
  // When a Loan is written off, this JournalEntry is the balanced GL voucher
  // that debits the loss account and credits the loan receivable.
  writeOffLoans Loan[] @relation("LoanWriteOffJournal")

  // ── Balance-change history (D8) ──────────────────────────────────────────
  // Per-line balance snapshots for the Account Ledger view.
  accountBalanceHistories AccountBalanceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite index for the journal-entry list filter: "entries on date X by status by voucher type" (D16).
  @@index([entryDate, status, voucherType])
}

// Journal Line = a single posting (debit OR credit) to one account
model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)
  memo   String?

  createdAt DateTime @default(now())
}

// ====================== TRANSACTIONS MODULE ======================
// Unified financial engine with Maker-Checker approval workflow and full
// double-entry accounting integration. Every approved transaction writes to
// BOTH the member-facing Savings ledger AND the General Ledger
// (JournalEntry + JournalLine) atomically, linked by shared ids.
// Approved transactions are immutable — corrections require a Reversal.

// The 4 top-level transaction categories (spec §3).
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  CHARGE
  INCOME_DISTRIBUTION
}

// Detailed sub-types. Member-side and Future-side entries share this enum
// for forward compatibility (loan disbursement, admission fee, shares, etc.
// are stubbed TODO(PHASE 2)).
enum TransactionSubType {
  // Member deposits
  SAVINGS_DEPOSIT
  ADVANCE
  DUE_PAYMENT
  // Charges
  SERVICE_CHARGE
  BANK_CHARGE
  ANNUAL_FEE
  ADMIN_CHARGE
  FINE_PENALTY
  OTHER_CHARGE
  // Generic marker for dynamic charge types created on the Fees & Charge Setup
  // → Charge Type tab. The human-readable name is stored on Transaction.chargeTypeName.
  CUSTOM_CHARGE
  // Income distribution sources
  PROJECT_PROFIT
  BANK_INTEREST
  INVESTMENT_INCOME
  DIVIDEND
  OTHER_INCOME
  // Future (Phase 2 stubs)
  LOAN_DISBURSEMENT
  LOAN_INSTALLMENT
  ADMISSION_FEE
  MEMBERSHIP_FEE
  SHARE_PURCHASE
  SHARE_REFUND
}

// Which ledger this transaction touches.
enum TransactionCategory {
  MEMBER
  FUTURE
}

// Payment / collection method (spec §6).
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  BKASH
  NAGAD
  ROCKET
}

// Approval workflow status (spec §5).
enum TransactionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RETURNED
  REJECTED
  REVERSED
}

// Approval tier resolved at submit time from ApprovalLimit by amount (spec §13).
enum ApprovalLevel {
  L1
  L2
  L3
}

model Transaction {
  id              String              @id @default(uuid())
  voucherNo       String              @unique // TR-DEP-000001 etc. (atomic via Counter)
  transactionType TransactionType
  subType         TransactionSubType
  // ── Optimistic concurrency (B11) ─────────────────────────────────────────
  // Bumped on every write so concurrent approvals fail loudly instead of
  // silently overwriting each other. See `where: { id, version }` pattern.
  version         Int                 @default(0)
  // ── Term-deposit link (Roadmap item 22) ──────────────────────────────────
  // Back-relation: a Transaction may be the principal-deposit leg of a
  // MemberDeposit. The FK column lives on MemberDeposit.transactionId (1:1),
  // so Transaction itself has no memberDepositId column — this field is the
  // implicit Prisma back-reference.
  memberDeposit   MemberDeposit?      @relation
  // For dynamic charge types (subType = CUSTOM_CHARGE), the human-readable name
  // chosen on the Fees & Charge Setup → Charge Type tab, snapshotted at creation.
  chargeTypeName  String?
  category        TransactionCategory @default(MEMBER)

  // Member this transaction affects (optional for some charges / distributions).
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Restrict)

  // Money & payment
  amount        Decimal        @db.Decimal(14, 2)
  paymentMethod PaymentMethod?
  cashAccountId String? // Cash Drawer / Bank / Mobile Wallet (Account)
  cashAccount   Account?       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  referenceNo   String?

  // Structured payload preserving the collection breakdown (deposit, principal,
  // interest, fine, other, discount) or member-wise income-distribution split.
  breakdown   Json?
  attachments Json    @default("[]") // [{type, name, url}]
  remarks     String? @db.Text

  // ── Status workflow ────────────────────────────────────────────────────
  status          TransactionStatus @default(DRAFT)
  approvalLevel   ApprovalLevel?
  returnReason    String?           @db.Text
  rejectionReason String?           @db.Text

  // ── Reversal linkage (spec §19/§29) ────────────────────────────────────
  // reversalOfId: if set, THIS row reverses the referenced transaction.
  // reversedById: set on the original when a reversal is created against it.
  // Self-relation: only one side owns the foreign key.
  reversalOfId   String?      @unique
  reversalOf     Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedById   String?      @unique
  reversedBy     Transaction? @relation("TransactionReversal")
  reversalReason String?      @db.Text

  // ── Posting links (filled atomically on approval) ─────────────────────
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  savingsMirrorId String?       @unique
  savingsMirror   Savings?      @relation(fields: [savingsMirrorId], references: [id], onDelete: Restrict)

  // ── Member-portal request origin ──────────────────────────────────────
  memberSubmitted Boolean        @default(false)
  memberRequestId String?
  memberRequest   MemberRequest? @relation(fields: [memberRequestId], references: [id], onDelete: SetNull)

  // ── Full audit trail (spec §18) ────────────────────────────────────────
  createdBy        String
  createdById      String
  createdAt        DateTime  @default(now())
  // Effective date of the transaction (when the money moved), separate from the
  // system createdAt. Lets collectors back-date entries recorded after the fact.
  transactionDate  DateTime  @default(now())
  submittedBy      String?
  submittedById    String?
  submittedAt      DateTime?
  approvedBy       String?
  approvedById     String?
  approvedAt       DateTime?
  returnedBy       String?
  returnedById     String?
  returnedAt       DateTime?
  rejectedBy       String?
  rejectedById     String?
  rejectedAt       DateTime?
  reversedByUser   String?
  reversedByUserId String?
  reversedAt       DateTime?
  ipAddress        String?
  deviceInfo       String?

  // Task Management Module — linked tasks
  tasks Task[]

  // Payment gateway integrations (bKash / Nagad) — back-relation.
  paymentIntents PaymentIntent[]

  @@index([status])
  @@index([transactionType, status])
  @@index([memberId])
  @@index([approvedAt])
  @@index([reversalOfId])
  @@index([cashAccountId])
  // Composite index for subType-scoped date-range scans (D16).
  @@index([subType, transactionDate])
}

// Approval tier configuration (spec §13). Resolved at submit time by amount.
// role values: SUPER_ADMIN | ADMIN. ADMIN rows additionally require the named
// permission key on the UserPermission table.
model ApprovalLimit {
  id         String   @id @default(uuid())
  level      Int // 1, 2, 3
  label      String // "Branch Manager", "Regional Manager", "Super Admin"
  role       String // SUPER_ADMIN | ADMIN
  // When role=ADMIN, this permission key (on UserPermission) is also required.
  permission String?
  minAmount  Decimal  @default(0) @db.Decimal(14, 2)
  maxAmount  Decimal  @db.Decimal(14, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([level, isActive])
}

// Atomic monotonic sequence counters — fixes the race-prone `count+1` voucher
// generation. Each id (e.g. "transaction", "TR-DEP") is incremented inside a
// `prisma.$transaction` with the row locked for update.
model Counter {
  id    String @id
  value Int    @default(0)
}

