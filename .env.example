# ──────────────────────────────────────────────────────────────────────────
# FSF Somiti — environment template
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local` for personal dev overrides) and
# fill in real values. NEVER commit the real .env to git.
#
# The .env is loaded by:
#   - prisma.config.js   (so Prisma CLI can resolve env("DATABASE_URL"))
#   - next.config.ts     (Next.js auto-loads .env / .env.local)
# ──────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase Pooler) ───────────────────────────────────────────
# IMPORTANT — read this before touching these URLs:
#
#   DATABASE_URL  →  Supabase TRANSACTION-MODE pooler (port 6543)
#                    MUST include ?pgbouncer=true&pgbouncer_no_instrument=true
#                    Use connection_limit=10 in production, 5 in dev.
#                    pool_timeout=30 gives requests a fair chance under burst.
#
#   DIRECT_URL    →  Supabase SESSION-MODE pooler (port 5432)
#                    MUST NOT include ?pgbouncer=true (Prisma will reject it)
#                    Used for `prisma migrate` and `directPrisma.$transaction`
#                    Keep connection_limit small (5 in prod, 3 in dev) so it
#                    doesn't starve the transaction-mode pooler of backends.
#
# Why two URLs? Supabase's transaction pooler multiplexes connections across
# short-lived serverless requests — perfect for Vercel Lambdas but breaks
# Prisma's interactive transactions (which need a pinned backend connection).
# See lib/prisma.ts for the full rationale.
#
# To get these URLs from Supabase:
#   Dashboard → Project Settings → Database → Connection string
#   Pick "Transaction" for DATABASE_URL and "Session" for DIRECT_URL.
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&pgbouncer_no_instrument=true&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=60"

# Optional Prisma overrides (lib/prisma.ts reads these — defaults shown):
# PRISMA_POOL_LIMIT=10            # connection_limit for DATABASE_URL (prod)
# PRISMA_POOL_TIMEOUT=30          # pool_timeout for DATABASE_URL
# PRISMA_DIRECT_LIMIT=5           # connection_limit for DIRECT_URL
# PRISMA_DIRECT_TIMEOUT=60        # pool_timeout for DIRECT_URL
# PRISMA_LOG=warn,error           # comma-separated: query,info,warn,error

# ─── Encryption ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Used by lib/crypto.ts to encrypt mail/SMS secrets stored in the DB.
# MUST be identical across local/staging/production. If this changes, previously-
# saved secrets can no longer be decrypted and must be re-saved in Settings.
ENCRYPTION_KEY=""

# Used by lib/elections/ballotCrypto.ts to encrypt election ballots.
# Generate with: openssl rand -base64 48
BALLOT_ENCRYPTION_KEY=""

# ─── NextAuth ───────────────────────────────────────────────────────────
# Generate fresh with: openssl rand -base64 48
# NEVER use the placeholder value — anyone can forge JWTs.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ─── Email ──────────────────────────────────────────────────────────────
# Resend is the primary transport; nodemailer/Gmail is the fallback.
RESEND_API_KEY=""
EMAIL_USER=""
EMAIL_PASS=""

# ─── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── SMS Gateway (SENDMYSMS) ──────────────────────────────────────────
SMS_USER=""
SMS_KEY=""

# ─── Cron (REQUIRED — fail-closed if unset) ──────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Monitoring (optional) ──────────────────────────────────────────
SENTRY_DSN=""

# ─── Rate limiting (optional — falls back to in-memory) ────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Offsite backup (optional — falls back to local FS) ───────────
S3_BACKUP_BUCKET=""
S3_BACKUP_REGION=""
S3_BACKUP_ACCESS_KEY_ID=""
S3_BACKUP_SECRET_ACCESS_KEY=""

# ─── MFA (optional — admin enrollment gated by feature flag) ──────
MFA_ENABLED="true"

# ─── bKash ──────────────────────────────────────────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX="true"
# Callback URL — must be publicly reachable. Set to your production URL.
BKASH_CALLBACK_URL="http://localhost:3000/api/payments/bkash/callback"

# ─── Nagad ──────────────────────────────────────────────────
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
NAGAD_SANDBOX="true"
NAGAD_CALLBACK_URL="http://localhost:3000/api/payments/nagad/callback"
