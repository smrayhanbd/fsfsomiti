# ─── Database ────────────────────────────────────────────────────────────
# Transaction-mode pooler (port 6543) for app queries. Multiplexes short-lived
# serverless clients over a small backend pool — fixes EMAXCONNSESSION.
DATABASE_URL="postgresql://USER:PASS@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"

# Session-mode pooler (port 5432) for Prisma migrations AND interactive
# transactions (directPrisma.$transaction). Bypasses the transaction pooler.
DIRECT_URL="postgresql://USER:PASS@HOST.pooler.supabase.com:5432/postgres"

# ─── Encryption ──────────────────────────────────────────────────────────
# Generates with: openssl rand -base64 48
# Used by lib/crypto.ts to encrypt mail/SMS secrets stored in the DB.
# MUST be identical across local/staging/production. If this changes, previously-
# saved secrets can no longer be decrypted and must be re-saved in Settings.
ENCRYPTION_KEY=""
BALLOT_ENCRYPTION_KEY=""

# ─── NextAuth ───────────────────────────────────────────────────────────
# Generate fresh with: openssl rand -base64 48
# NEVER use the placeholder value — anyone can forge JWTs.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ─── Email ──────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_USER=""
EMAIL_PASS=""

# ─── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── SMS Gateway (BulkSMSBD) ──────────────────────────────────────────
SMS_USER=""
SMS_KEY=""

# ─── Cron auth (REQUIRED for manual admin triggers) ─────────────────
# Generate with: openssl rand -hex 32
# Used by the /api/{backup/run,loans/late-fee,loans/npl-scan,
# deposits/maturity-scan,messages/retry} routes to authorize manual
# admin triggers + any external caller hitting those URLs.
#
# Inngest does NOT use this secret — it has its own signing key below.
# But the route handlers still check it so admins can fire jobs on-demand.
CRON_SECRET=""

# ─── Inngest (REQUIRED — the project's sole cron scheduler) ─────────
# All 5 scheduled jobs (backup, late-fee, npl-scan, maturity-scan,
# message-retry) run via Inngest. Without these env vars, NO cron jobs
# will fire in production.
#
# Setup:
#   1. Sign up at https://www.inngest.com (free tier, no credit card)
#   2. Create an app → copy the Event Key + Signing Key
#   3. Add both to Vercel env vars (Production + Preview environments)
#   4. In the Inngest dashboard, add your app URL:
#        https://YOUR-DEPLOYMENT.vercel.app/api/inngest
#   5. Redeploy so Inngest can sync your functions.
#
# Local dev: run `npx inngest-cli@latest dev` to start the Inngest dev
# server, which detects your Next.js app and fires schedules locally
# without needing these env vars set.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Monitoring (optional) ──────────────────────────────────────────
SENTRY_DSN=""

# ─── Rate limiting (optional — falls back to in-memory) ────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Offsite backup (optional — falls back to local FS) ────────────
S3_BACKUP_BUCKET=""
S3_BACKUP_REGION=""
S3_BACKUP_ACCESS_KEY_ID=""
S3_BACKUP_SECRET_ACCESS_KEY=""

# ─── MFA (optional — admin enrollment gated by feature flag) ──────
MFA_ENABLED="true"

# ─── bKash ──────────────────────────────────────────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX="true"
# Callback URL — must be publicly reachable. Set to your production URL.
BKASH_CALLBACK_URL="http://localhost:3000/api/payments/bkash/callback"

# ─── Nagad ──────────────────────────────────────────────────
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
NAGAD_SANDBOX="true"
NAGAD_CALLBACK_URL="http://localhost:3000/api/payments/nagad/callback"
