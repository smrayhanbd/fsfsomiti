    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "dotenv": "^16.4.5",
    "pino-pretty": "^11.3.0",
