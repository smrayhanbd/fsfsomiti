    "framer-motion": "^12.42.2",
    "inngest": "^3.54.2",
    "lucide-react": "^1.24.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.14",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.5.0",
    "prisma": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
