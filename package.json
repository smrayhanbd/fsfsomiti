{
  "name": "future-savings-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node prisma/seed.js && node prisma/seed-permissions.js",
    "seed:rbac": "node prisma/seed-permissions.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "schema:check": "node scripts/check-schema-sync.mjs",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma db seed",
    "db:push": "prisma db push --force-reset",
    "db:migrate": "prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
